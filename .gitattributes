# Autodetect text files; normalize to LF in the GitHub Pages repo
* text=auto eol=lf

# Keep Windows batch files usable when checked out on Windows
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.tgz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.xls binary
*.xlsx binary
